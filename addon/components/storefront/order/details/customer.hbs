<ContentPanel @title={{t "storefront.order-details.customer"}} @open={{true}} @isLoading={{@isLoading}} @wrapperClass="bordered-top" ...attributes>
    <div class="storefront-order-customer">
        <div class="storefront-order-person">
            <Image
                src={{avatar-url @resource.customer.photo_url}}
                @fallbackSrc={{config "defaultValues.contactImage"}}
                class="storefront-order-person__avatar"
                alt={{@resource.customer.name}}
            />
            <div class="min-w-0">
                <div class="storefront-order-person__name">{{n-a @resource.customer.name (t "storefront.order-details.no-customer")}}</div>
                <div class="storefront-order-person__meta">{{n-a @resource.customer.email (t "storefront.order-details.no-email")}}</div>
                <div class="storefront-order-person__meta">{{n-a @resource.customer.phone (t "storefront.order-details.no-phone")}}</div>
            </div>
        </div>

        {{#unless @resource.meta.is_pickup}}
            <div class="storefront-order-detail-block">
                <div class="storefront-order-detail-block__label">{{t "storefront.order-details.delivery-address"}}</div>
                <DisplayPlace @place={{@resource.payload.dropoff}} @type="dropoff" @addressClass="text-sm dark:text-gray-100" @noAddressClass="text-sm" />
            </div>
        {{/unless}}
    </div>
</ContentPanel>
