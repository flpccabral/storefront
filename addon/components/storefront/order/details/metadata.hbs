<ContentPanel
    @title={{t "storefront.order-details.metadata"}}
    @open={{true}}
    @isLoading={{@isLoading}}
    @actionButtons={{@actionButtons}}
    @wrapperClass="bordered-top"
    @panelBodyWrapperClass={{unless this.emptyMetadata "px-0i" ""}}
    ...attributes
>
    <MetadataViewer @metadata={{@resource.meta}} />
</ContentPanel>
