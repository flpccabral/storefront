<Layout::Resource::Tabular
    @resource="customer"
    @title={{t "storefront.common.customers"}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.search}}
    @data={{@model}}
    @columns={{this.columns}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @setupTable={{fn (mut this.table)}}
    @actionButtons={{this.actionButtons}}
    @controller={{this}}
    @emptyStateComponent={{component
        "table/empty-state"
        icon="users"
        title=(t "storefront.customer-list.empty.title")
        description=(t "storefront.customer-list.empty.description")
        filteredTitle=(t "storefront.customer-list.empty.filtered-title")
        filteredDescription=(t "storefront.customer-list.empty.filtered-description")
    }}
/>

{{outlet}}
